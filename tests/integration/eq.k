; (.t, {}, {}, .t, .t, {}, {}, {}, .t, .t, .t, {})

eq x = {x}

main = (
    (eq 0 0),
    (eq 0 1),
    (eq 0 {.a}),
    (eq {.a = 1} {.a = 1}),
    (eq {.a = 1, .b = 2} {.b = 2, .a = 1}),
    (eq {.a = 1} {.a = 2}),
    (eq {.a = 1} {.a = 1, .b = 2}),
    (eq {.a = 1, .b = 2} {.a = 1}),
    (eq {} {}),
    (eq {.a = {.b = 1}} {.a = {.b = 1}}),
    (eq "hi" "hi"),
    (eq "hi" "hey"),
)