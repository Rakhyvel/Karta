; (0, 300, 200, 1, 3, 5, 100, 100, 100, 200)

f [a, b] = @sub(a, b)
f _ = 100

g [a, b, ..rest] = @sub(a, b)
g _ = 200

main = (
    (f [0, 0]),
    (f [300, 0]),
    (f {.head = 210, .tail = {.head = 10, .tail = {}}}),
    (f [2, 1]),
    (g [5, 2]),
    (g [9, 4, 1]),
    (f []),
    (f [1]),
    (f [1, 2, 3]),
    (g [1]),
)