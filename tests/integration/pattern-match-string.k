; (100, 100, 150, 200, 200, 200, 200, 100, 100, 100, 100)

f "hi" = 100
f {"hey"} = 150
f _ = 200

g "" = 100
g _ = 200

main = (
    (f "hi"),
    (f {.head = 'h', .tail = {.head = 'i', .tail = {}}}),
    (f {"hey"}),
    (f {"sup"}),
    (f "hill"),
    (f "h"),
    (f ""),
    (g ""),
    (g []),
    (g ()),
    (g {}),
)